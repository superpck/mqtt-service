PORT=3001
SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
CORS_ORIGIN=*

DB_HOST=localhost
DB_CLIENT=mysql2
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_POOL_MIN=2
DB_POOL_MAX=10

# MQTT broker transports (aedes)
MQTT_HOST=0.0.0.0
MQTT_TCP_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_TLS_PORT=8883
MQTT_TLS_KEY_PATH=
MQTT_TLS_CERT_PATH=
MQTT_WS_PORT=8083
MQTT_WS_PATH=/mqtt
MQTT_PUBLIC_HOST=localhost

# admin.mqtt_event retention + write-buffer tuning
MQTT_EVENT_RETENTION_DAYS=90
MQTT_EVENT_PARTITION_BUFFER_DAYS=10
MQTT_EVENT_PARTITION_LOOKAHEAD_DAYS=3
MQTT_EVENT_PARTITION_MAINTENANCE_HOUR=2
MQTT_EVENT_FLUSH_INTERVAL_MS=200
MQTT_EVENT_FLUSH_MAX_BATCH=1000
MQTT_EVENT_BUFFER_MAX_SIZE=50000

# admin.mqtt_subscribe housekeeping
SUBSCRIBE_EXPIRE_SWEEP_INTERVAL_MS=60000

# rate limit สำหรับ POST /subscribe-requests
SUBSCRIBE_RATE_LIMIT_WINDOW_MS=60000
SUBSCRIBE_RATE_LIMIT_MAX=20
